{
  "name": "@propure/convex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./server": {
      "types": "./convex/_generated/server.d.ts",
      "default": "./convex/_generated/server.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts",
      "default": "./convex/_generated/dataModel.js"
    }
  },
  "files": [
    "convex/_generated"
  ],
  "scripts": {
    "convex:dev": "convex dev",
    "convex:setup": "convex dev --until-success",
    "convex:typecheck": "tsc --noEmit -p convex"
  },
  "dependencies": {
    "convex": "^1.31.6",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5"
  }
}