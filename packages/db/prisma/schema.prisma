// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum StrategyType {
  CASH_FLOW
  CAPITAL_GROWTH
  RENOVATION_FLIP
  DEVELOPMENT
  SMSF
  COMMERCIAL
}

enum StrategyStatus {
  DISCOVERY
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum PropertyType {
  HOUSE
  APARTMENT
  TOWNHOUSE
  VILLA
  UNIT
  LAND
  RURAL
  COMMERCIAL
  INDUSTRIAL
}

enum ListingType {
  SALE
  RENT
  SOLD
  LEASED
}

enum DataSource {
  DOMAIN
  REALESTATE
  CORELOGIC
  ABS
  RBA
  MANUAL
}

enum ListingStatus {
  ACTIVE
  UNDER_CONTRACT
  SOLD
  WITHDRAWN
  OFF_MARKET
}

// ============================================================================
// USER & AUTH MODELS
// ============================================================================

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  strategies    Strategy[]
  chatSessions  ChatSession[]
  savedSearches SavedSearch[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================================
// STRATEGY & CHAT MODELS
// ============================================================================

model Strategy {
  id              String         @id @default(cuid())
  userId          String
  type            StrategyType
  status          StrategyStatus @default(DISCOVERY)
  params          Json? // Flexible JSON for strategy-specific parameters
  budget          Float?
  deposit         Float?
  income          Float?
  riskTolerance   String? // low, medium, high
  timeline        String? // short, medium, long
  managementStyle String? // hands-on, passive, mixed
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("strategies")
}

model ChatSession {
  id         String   @id @default(cuid())
  userId     String
  strategyId String?
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy?     @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@index([strategyId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(cuid())
  chatSessionId String
  role          String // user, assistant, system, tool
  content       String   @db.Text
  toolCalls     Json? // Array of tool call objects
  toolResults   Json? // Array of tool result objects
  createdAt     DateTime @default(now())

  // Relations
  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  filters   Json // Search filter criteria
  results   Json? // Cached search results
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

// ============================================================================
// LOCATION MODELS
// ============================================================================

model State {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "New South Wales"
  code      String   @unique // e.g., "NSW"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cities City[]

  @@map("states")
}

model City {
  id        String   @id @default(cuid())
  stateId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  state   State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  suburbs Suburb[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("cities")
}

model Suburb {
  id        String   @id @default(cuid())
  cityId    String
  name      String
  postcode  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  city       City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties Property[]
  metrics    SuburbMetric[]

  @@unique([cityId, name, postcode])
  @@index([cityId])
  @@index([postcode])
  @@map("suburbs")
}

// ============================================================================
// PROPERTY MODELS
// ============================================================================

model Property {
  id            String        @id @default(cuid())
  externalId    String?       @unique // ID from external data source (e.g., "domain-123", "rea-456")
  suburbId      String
  address       String
  latitude      Float?
  longitude     Float?
  propertyType  PropertyType
  listingType   ListingType
  listingStatus ListingStatus @default(ACTIVE)
  source        DataSource    @default(MANUAL)
  sourceUrl     String?
  price         Float?
  rentWeekly    Float?
  bedrooms      Int?
  bathrooms     Int?
  carSpaces     Int?
  landSize      Float? // in square meters
  buildingSize  Float? // in square meters
  description   String?       @db.Text
  features      Json? // Array of feature strings
  images        Json? // Array of image URLs
  agentId       String?
  agencyId      String?
  scrapedAt     DateTime? // When the data was last scraped
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  suburb       Suburb         @relation(fields: [suburbId], references: [id], onDelete: Cascade)
  agent        Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agency       Agency?        @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  priceHistory PriceHistory[]

  @@index([suburbId])
  @@index([propertyType])
  @@index([listingType])
  @@index([listingStatus])
  @@index([source])
  @@index([price])
  @@index([bedrooms])
  @@index([agentId])
  @@index([agencyId])
  @@index([latitude, longitude])
  @@map("properties")
}

model SuburbMetric {
  id         String   @id @default(cuid())
  suburbId   String
  metricType String // e.g., "median_price", "rental_yield", "vacancy_rate", "growth_rate"
  value      Float
  source     String? // e.g., "domain", "corelogic", "abs"
  recordedAt DateTime
  createdAt  DateTime @default(now())

  // Relations
  suburb Suburb @relation(fields: [suburbId], references: [id], onDelete: Cascade)

  @@unique([suburbId, metricType, recordedAt])
  @@index([suburbId])
  @@index([metricType])
  @@index([recordedAt])
  @@map("suburb_metrics")
}

// ============================================================================
// AGENT & AGENCY MODELS
// ============================================================================

model Agent {
  id         String     @id @default(cuid())
  externalId String?    @unique // ID from external source (e.g., "domain-agent-123")
  source     DataSource
  name       String
  email      String?
  phone      String?
  profileUrl String?
  photoUrl   String?
  agencyId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  agency     Agency?    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  properties Property[]

  @@index([agencyId])
  @@index([source])
  @@map("agents")
}

model Agency {
  id         String     @id @default(cuid())
  externalId String?    @unique // ID from external source (e.g., "domain-agency-456")
  source     DataSource
  name       String
  logoUrl    String?
  website    String?
  phone      String?
  address    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  agents     Agent[]
  properties Property[]

  @@index([source])
  @@map("agencies")
}

// ============================================================================
// PRICE & SALES HISTORY
// ============================================================================

model PriceHistory {
  id         String     @id @default(cuid())
  propertyId String
  price      Float?
  priceType  String // "asking", "sold", "rent"
  priceText  String? // Original price text (e.g., "$1.2M - $1.4M")
  recordedAt DateTime
  source     DataSource
  createdAt  DateTime   @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([recordedAt])
  @@index([priceType])
  @@map("price_history")
}

model SaleRecord {
  id        String     @id @default(cuid())
  address   String
  suburb    String
  state     String
  postcode  String?
  saleDate  DateTime
  salePrice Float
  saleType  String // "auction", "private_sale", "expression_of_interest"
  source    DataSource
  sourceUrl String?
  createdAt DateTime   @default(now())

  @@index([suburb, state])
  @@index([saleDate])
  @@index([source])
  @@map("sale_records")
}

model AuctionResult {
  id          String     @id @default(cuid())
  address     String
  suburb      String
  state       String
  postcode    String?
  auctionDate DateTime
  result      String // "sold_at_auction", "passed_in", "sold_before", "sold_after", "withdrawn"
  guidePrice  Float?
  soldPrice   Float?
  bidderCount Int?
  source      DataSource
  createdAt   DateTime   @default(now())

  @@index([suburb, state])
  @@index([auctionDate])
  @@index([result])
  @@map("auction_results")
}

// ============================================================================
// MARKET & INFRASTRUCTURE DATA
// ============================================================================

model InfrastructureProject {
  id             String    @id @default(cuid())
  name           String
  description    String?   @db.Text
  category       String // "transport", "health", "education", "recreation", "commercial"
  status         String // "planned", "approved", "construction", "completed"
  state          String
  suburbs        String[] // Affected suburbs
  estimatedCost  Float?
  completionDate DateTime?
  sourceUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state])
  @@index([category])
  @@index([status])
  @@map("infrastructure_projects")
}

model MarketIndicator {
  id            String     @id @default(cuid())
  indicatorType String // "cash_rate", "unemployment", "gdp_growth", "inflation", "wage_growth"
  scope         String // "national", "NSW", "VIC", etc.
  value         Float
  unit          String? // "percent", "dollars", etc.
  recordedAt    DateTime
  source        DataSource
  createdAt     DateTime   @default(now())

  @@unique([indicatorType, scope, recordedAt])
  @@index([indicatorType])
  @@index([scope])
  @@index([recordedAt])
  @@map("market_indicators")
}
